{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/work/shell", "destination": "/work/energy-deal-operations", "permanent": true },
    { "source": "/work/cctns", "destination": "/work/public-sector-citizen-services", "permanent": true },
    { "source": "/work/central-union-bank", "destination": "/work/banking-ai-self-service", "permanent": true },
    { "source": "/work/indusind", "destination": "/work/retail-banking-onboarding", "permanent": true },
    { "source": "/work/torrent-patient-app", "destination": "/work/healthcare-patient-experience", "permanent": true },
    { "source": "/work/nykaa-adtech", "destination": "/work/commerce-ad-operations", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*).(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    },
    {
      "source": "/(.*).(svg|png|jpg|jpeg|webp|woff2|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
